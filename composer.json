{
    "name": "hot-ui/hot-ui",
    "description": "Hot-UI — zero-dependency shadcn-style UI component library for plain PHP 8.2+ with typed Alpine.js islands. No framework, no template engine: works in CodeIgniter 4, League Plates, Blade or any PHP app.",
    "type": "composer-plugin",
    "license": "MIT",
    "version": "0.19.0",
    "authors": [
        {
            "name": "Arvelo Falcon",
            "email": "arvelofalcon@gmail.com"
        }
    ],
    "keywords": [
        "codeigniter",
        "components",
        "ui",
        "alpinejs",
        "shadcn",
        "tailwind",
        "no-framework",
        "zero-dependency"
    ],
    "require": {
        "php": "^8.2",
        "composer-plugin-api": "^2.6"
    },
    "require-dev": {
        "composer/composer": "^2.7",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Components\\": "src/Components/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Components\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "@php bin/hot-ui lint",
        "hooks": "@php bin/hot-ui hooks:install",
        "smoke": "@php bin/hot-ui smoke",
        "examples": "@php bin/hot-ui examples"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "archive": {
        "exclude": [
            "/node_modules",
            "/vendor",
            "/demo",
            "/docs",
            "/tests",
            "/.githooks",
            "/.agents",
            "/.claude",
            "/.docgen",
            "/agent",
            "/composer.lock",
            "/.phpunit.cache",
            "/phpunit.xml",
            "/tsconfig.json",
            "/package.json",
            "/package-lock.json",
            "/js/src/**/*.ts",
            "/js/src/**/*.d.ts",
            "/js/src/**/*.map"
        ]
    },
    "extra": {
        "class": "Components\\Composer\\HotUIPlugin",
        "hot-ui": {
            "assets": [
                "css",
                "js"
            ],
            "views": "views",
            "install-command": "Components\\Commands\\InstallCommand"
        },
        "codeigniter4": {
            "commands": [
                "Components\\Commands"
            ]
        }
    },
    "minimum-stability": "stable"
}

<?php
/**
 * {{class}} component template (plain/basic version)
 * 
 * This is a basic template structure for the {{class}} component.
 * Customize this markup to fit your specific needs.
 * 
 * Component: {{class}}
 * Generated: {{date}}
 * 
 * Tips for customization:
 * - Use hot:model for reactive input bindings
 * - Use hot:click for action bindings
 * - Keep the data-hot-component attribute for Hotfire integration
 * - Leverage Tailwind CSS classes for styling
 */
?>
<div 
    class="hotfire-{{class}} p-4 border rounded-lg bg-white shadow-sm"
    data-hot-component="<?= $component::class ?>"
>
    <!-- Add your component markup here -->
    <div class="text-gray-600">
        <p>{{class}} component template</p>
        <p class="text-sm text-gray-500">
            Generated by make:hotfire. Customize this template as needed.
        </p>
    </div>
    
    <!-- Example of reactive content -->
    <?php if (!empty($props)): ?>
        <div class="mt-4 space-y-2">
            <?php foreach ($props as $prop): ?>
                <div class="p-2 bg-gray-50 rounded">
                    <span class="font-medium"><?= htmlspecialchars($prop) ?>:</span>
                    <span class="text-gray-600">
                        <?= htmlspecialchars((string) ($component->{$prop} ?? 'N/A')) ?>
                    </span>
                </div>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>
</div>

<?php
/**
 * Field template for {{prop}} property
 * 
 * This field includes:
 * - Label for accessibility
 * - Input with hot:model binding for reactivity
 * - Value binding to component state
 * - Basic styling with Tailwind CSS
 * 
 * @var string $prop - Property name
 * @var string $title - Field title/label
 */
?>
<div class="form-group">
    <label 
        for="{{prop}}" 
        class="block text-sm font-medium text-gray-700 mb-1"
    >
        <?= htmlspecialchars($title) ?>
    </label>
    <input 
        type="text" 
        id="{{prop}}"
        name="{{prop}}"
        hot:model="{{prop}}" 
        value="<?= htmlspecialchars((string) $component->{$prop}) ?>"
        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        placeholder="Enter <?= htmlspecialchars($title) ?>"
        required
    />
    <p class="mt-1 text-xs text-gray-500">
        Enter your <?= htmlspecialchars(strtolower($title)) ?>
    </p>
</div>

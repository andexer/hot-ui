<?php
/**
 * Advanced form template with Hotfire form binding
 * 
 * This template demonstrates:
 * - Radio buttons (single selection)
 * - Checkboxes (grouped arrays)
 * - Multi-select
 * - Nested values (user.name)
 * - Field errors
 * 
 * Component: {{class}}
 * Generated: {{date}}
 */
?>
<form class="space-y-6" method="post">
    <!-- Text input with error handling -->
    <div class="form-group">
        <label for="title" class="block text-sm font-medium text-gray-700 mb-1">
            Title
        </label>
        <input
            type="text"
            id="title"
            name="title"
            hot:model="title"
            value="<?= htmlspecialchars((string) ($component->title ?? '')) ?>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <?php if (Components\Hotfire\FormBinder::hasError($component, 'title')): ?>
            <p class="mt-1 text-sm text-red-600">
                <?= htmlspecialchars(Components\Hotfire\FormBinder::error($component, 'title')) ?>
            </p>
        <?php endif; ?>
    </div>

    <!-- Radio buttons (single selection) -->
    <div class="form-group">
        <label class="block text-sm font-medium text-gray-700 mb-2">
            Status
        </label>
        <?php foreach (['active', 'inactive', 'pending'] as $status): ?>
            <label class="inline-flex items-center mr-4">
                <input
                    type="radio"
                    name="status"
                    value="<?= htmlspecialchars($status) ?>"
                    hot:model="status"
                    <?= Components\Hotfire\FormBinder::checked($component, 'status', $status) ? 'checked' : '' ?>
                    class="mr-2"
                />
                <span class="text-gray-700"><?= htmlspecialchars(ucfirst($status)) ?></span>
            </label>
        <?php endforeach; ?>
    </div>

    <!-- Checkboxes (grouped arrays) -->
    <div class="form-group">
        <label class="block text-sm font-medium text-gray-700 mb-2">
            Categories
        </label>
        <?php foreach (['technology', 'design', 'business'] as $category): ?>
            <label class="inline-flex items-center mr-4">
                <input
                    type="checkbox"
                    name="categories[]"
                    value="<?= htmlspecialchars($category) ?>"
                    hot:model="categories"
                    hot:model-array="true"
                    <?= Components\Hotfire\FormBinder::checkboxChecked($component, 'categories', $category) ? 'checked' : '' ?>
                    class="mr-2"
                />
                <span class="text-gray-700"><?= htmlspecialchars(ucfirst($category)) ?></span>
            </label>
        <?php endforeach; ?>
    </div>

    <!-- Multi-select -->
    <div class="form-group">
        <label for="tags" class="block text-sm font-medium text-gray-700 mb-1">
            Tags
        </label>
        <select
            id="tags"
            name="tags[]"
            hot:model="tags"
            hot:model-array="true"
            multiple
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
            <?php foreach (['php', 'javascript', 'python', 'go'] as $tag): ?>
                <option
                    value="<?= htmlspecialchars($tag) ?>"
                    <?= Components\Hotfire\FormBinder::checkboxChecked($component, 'tags', $tag) ? 'selected' : '' ?>
                >
                    <?= htmlspecialchars(ucfirst($tag)) ?>
                </option>
            <?php endforeach; ?>
        </select>
    </div>

    <!-- Nested values (user.name) -->
    <div class="form-group">
        <label for="user_name" class="block text-sm font-medium text-gray-700 mb-1">
            User Name
        </label>
        <input
            type="text"
            id="user_name"
            name="user.name"
            hot:model="user.name"
            value="<?= htmlspecialchars((string) (Components\Hotfire\FormBinder::value($component, 'user.name') ?? '')) ?>"
            class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
    </div>

    <!-- Submit button -->
    <button
        type="submit"
        hot:submit="save"
        class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
    >
        Save
    </button>
</form>

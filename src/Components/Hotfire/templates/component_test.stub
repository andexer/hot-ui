<?php

declare(strict_types=1);

namespace {{testNamespace}};

use {{classFqcn}};
use CodeIgniter\Test\CIUnitTestCase;
use Components\Hotfire\Engine;
use Components\Hotfire\Snapshot;
use Components\Ui;

final class {{class}}Test extends CIUnitTestCase
{
    public function testRenderSignedRoot(): void
    {
        $result = Engine::render(new {{class}}(), '/hot-ui/update', 'test-key', $this->ui());

        self::assertStringContainsString('data-hot-component', $result['html']);
        self::assertStringContainsString('data-hot-snapshot="'.$result['snapshot']['payload'].'"', $result['html']);
    }

    public function testModelRoundTrip(): void
    {
        $component = new {{class}}();
        $signed = Snapshot::encode(['class' => {{class}}::class, 'state' => $component->state()], 'test-key');

        $result = Engine::call(
            $signed,
            ['name' => 'model', 'property' => 'title', 'value' => 'Hello'],
            '/hot-ui/update',
            'test-key',
            $this->ui(),
        );

        self::assertStringContainsString('value="Hello"', $result['html']);
    }

    public function testTamperedSnapshotRejected(): void
    {
        $component = new {{class}}();
        $signed = Snapshot::encode(['class' => {{class}}::class, 'state' => $component->state()], 'test-key');
        $signed['checksum'] = 'f'.substr((string) $signed['checksum'], 1);

        $this->expectException(\InvalidArgumentException::class);
        Engine::call($signed, ['name' => 'poll'], '/hot-ui/update', 'test-key', $this->ui());
    }

    private function ui(): Ui
    {
        return new Ui(rtrim(APPPATH, '/\\').'/Views');
    }
}